PROJECT_NAME="RAMEERDER PACE GROUP API"
API_PREFIX="/api"

# CORS configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# PostgreSQL Database URL (Asyncpg)
# Format: postgresql+asyncpg://user:password@localhost:5432/database_name
DATABASE_URL="postgresql+asyncpg://postgres:123456789d@localhost:5432/rameerder_db"

# PAYMENT PROVIDER SECRETS
# Do not store real production keys here, use environment variables in Render
MTN_MOMO_API_KEY="dev_mtn_api_key"
MTN_MOMO_API_SECRET="dev_mtn_api_secret"
ORANGE_MONEY_CLIENT_ID="dev_orange_client_id"
ORANGE_MONEY_CLIENT_SECRET="dev_orange_client_secret"
CARD_GATEWAY_SECRET="dev_stripe_or_flutterwave_secret"
CARD_WEBHOOK_SECRET="dev_webhook_signing_secret"

# Notification Providers
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="no-reply@rameerderpace.com"
SMTP_PASSWORD="dev_email_password"
TWILIO_SMS_KEY="dev_sms_key"
WHATSAPP_API_KEY="dev_whatsapp_key"
PUSH_API_KEY="dev_push_key"